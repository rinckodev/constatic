{
    "compilerOptions": {
      "module": "NodeNext",
      "target": "ESNext",
      "moduleResolution": "NodeNext",
      "resolveJsonModule": true,
      "strict": true,
      "esModuleInterop": true,
      "skipLibCheck": true,

      "types": ["node", "bun"],

      "rootDir": "./src",
      "outDir": "./build",
      "emitDeclarationOnly": false,

      "noUnusedLocals": true,
      "noUnusedParameters": true,
      "paths": {
        "#helpers": ["./src/helpers/index.js"],
        "#prompts": ["./src/helpers/helper.prompts.js"],
        "#menus": ["./src/menus/index.js"],
        "#program": ["./src/program/index.js"],
        "#shared/*": ["./src/shared/*"],
        "#lib/*": ["./src/lib/*"],
        "#utils/*": ["./src/utils/*"],
        "#actions/*": ["./src/actions/*"],
        "#actions": ["./src/actions/index.js"],
        "#types": ["./src/@types/index.js"],
        "#cli": ["./src/cli/index.js"],
      }
    },
    "include": ["src"],
    "exclude": ["node_modules", "deprecated", "dist", "build"],
  }