{
  "name": "constatic",
  "version": "1.5.9",
  "description": "Constatic is a CLI for creating and managing modern TypeScript projects, providing an organized structure and features that streamline development.",
  "main": "build/index.js",
  "type": "module",
  "bin": {
    "constatic": "build/index.js"
  },
  "scripts": {
    "build": "bun run ./build.ts",
    "link": "npm unlink constatic && npm link",
    "predev": "bun run build && rm -rf playground && mkdir ./playground",
    "dev": "cd ./playground && bun run ../build/index.js",
    "check": "tsc --noEmit"
  },
  "keywords": [
    "discord",
    "discord bot",
    "bots",
    "bot",
    "auth bot",
    "oauth2",
    "oauth2 bot",
    "oauth2 discord",
    "typesafe",
    "typescript",
    "components",
    "commands",
    "events",
    "discord.js",
    "discordjs",
    "buttons",
    "modals",
    "select menus",
    "dropdown",
    "handler",
    "command handler",
    "event handler",
    "boilerplate",
    "bot boilerplate",
    "CLI",
    "cli",
    "prompts",
    "prompt",
    "database",
    "databases",
    "mongodb",
    "mysql",
    "mariadb",
    "prisma",
    "postgres",
    "sql",
    "nosql",
    "zod",
    "fastify",
    "express"
  ],
  "homepage": "https://github.com/rinckodev/constatic/tools/cli#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/rinckodev/constatic",
    "directory": "tools/cli"
  },
  "author": {
    "name": "Rincko Dev",
    "url": "https://github.com/rinckodev"
  },
  "license": "ISC",
  "devDependencies": {
    "@constatic/config": "*",
    "@types/bun": "^1.4.0",
    "@types/cross-spawn": "^6.0.6",
    "@types/fs-extra": "^11.0.4",
    "@types/lodash.merge": "^4.6.9",
    "@types/node": "^22.19.2",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@inquirer/prompts": "^8.7.0",
    "citty": "^0.1.6",
    "cli-table3": "^0.6.5",
    "conf": "12.0.0",
    "fs-extra": "11.2.0",
    "inquirer-select-pro": "^1.0.0-alpha.9",
    "inquirerjs-checkbox-search": "^2.1.2",
    "lodash.merge": "^4.6.2",
    "pkg-types": "^1.3.1",
    "ts-morph": "^26.0.0"
  },
  "imports": {
    "#root": ["./build/root.js"],
    "#helpers": [
      "./build/helpers/index.js"
    ],
    "#prompts": [
      "./build/helpers/helper.prompts.js"
    ],
    "#menus": [
      "./build/menus/index.js"
    ],
    "#program": [
      "./build/program/index.js"
    ],
    "#shared/*": [
      "./build/shared/*"
    ],
    "#lib/*": [
      "./build/lib/*"
    ],
    "#utils/*": [
      "./build/utils/*"
    ],
    "#actions/*": [
      "./build/actions/*"
    ],
    "#actions": [
      "./build/actions/index.js"
    ],
    "#types": [
      "./build/types/index.js"
    ],
    "#cli": [
      "./build/cli/index.js"
    ]
  }
}
